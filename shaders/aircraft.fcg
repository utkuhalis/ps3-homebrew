/* Ucak govdesi - fragment programi.
 *
 * Govde metalik: cevresini yansitir. Yansitilacak cevre dokudan degil, ayni
 * gokyuzu fonksiyonundan hesaplanir - su yuzeyi de zaten boyle calisiyor,
 * boylece ucak ve deniz ayni gokyuzunu gorur ve sahne tutarli kalir.
 *
 * Fresnel: yuzeye dik bakildiginda kendi rengi, siyirarak bakildiginda
 * yansima baskin. Metal olmayan parcalar (lastik, kaucuk) bu etkiden
 * neredeyse hic pay almaz. */

float3 sky_color(float3 dir, float3 sunDir, float3 horizon, float3 zenith,
                 float3 sunCol)
{
	float up = saturate(dir.y * 0.5f + 0.5f);
	float3 col = lerp(horizon, zenith, pow(up, 0.55f));
	float sd = saturate(dot(dir, sunDir));

	/* gunes diski ve halesi */
	col += (pow(sd, 220.0f) * 0.55f + pow(sd, 12.0f) * 0.16f) * sunCol;
	return col;
}

void main
(
	float4 color    : TEXCOORD0,   /* rgb + metaliklik */
	float4 worldPos : TEXCOORD1,
	float3 normalIn : TEXCOORD2,

	uniform float4 eyePosition,
	uniform float4 sunDir,
	uniform float4 sunColor,
	uniform float4 horizonCol,
	uniform float4 zenithCol,
	uniform float  fogDistance,

	out float4 oColor
)
{
	float3 n = normalize(normalIn);
	float3 v = normalize(worldPos.xyz - eyePosition.xyz);
	float metal = color.a;

	/* --- yonlu isik --- */
	float ndl = saturate(dot(n, sunDir.xyz));

	/* Gokyuzu yaygin isigi: ust yuzeyler gokyuzunden, alt yuzeyler denizden
	 * isik alir. Bu tek basina govdeye hacim kazandirir. */
	float sky_up = saturate(n.y * 0.5f + 0.5f);

	/* Gokyuzu isigi mavimsi olsa da beyaz bir govde beyaz kalmali; bu yuzden
	 * ortam isigi renk tonuyla karistirilirken beyaza dogru cekilir. */
	float3 sky_tint = lerp(horizonCol.xyz, zenithCol.xyz, sky_up);
	float3 ambient = lerp(float3(0.45f, 0.46f, 0.48f), sky_tint * 0.75f,
	                      0.45f);

	float3 base = color.rgb * (ambient + sunColor.xyz * ndl * 0.95f);

	/* --- gokyuzu yansimasi --- */
	float3 refl_dir = reflect(v, n);
	float3 refl = sky_color(refl_dir, sunDir.xyz, horizonCol.xyz,
	                        zenithCol.xyz, sunColor.xyz);

	/* Yansima govdenin rengini bastirmamali: metalik yuzeylerde bile taban
	 * renk gorunur kalir, yalnizca siyirarak bakilan yerlerde ayna etkisi
	 * one cikar. Ilk ayarda katsayilar yuksekti ve ucak bastan asagi
	 * gokyuzu mavisine donuyordu. */
	float fres = 0.03f + 0.97f * pow(1.0f - saturate(-dot(v, n)), 5.0f);
	float mirror = saturate(metal * 0.28f + fres * 0.45f * metal);

	float3 col = lerp(base, refl * lerp(color.rgb, float3(1.0f, 1.0f, 1.0f),
	                                    0.35f), mirror);

	/* --- keskin gunes parlamasi (fragment tarafinda, bu yuzden yumusak
	 *     degil gercekten parliyor) --- */
	{
		float3 h = normalize(sunDir.xyz - v);
		float nh = saturate(dot(n, h));
		float gloss = pow(nh, 90.0f) * (0.35f + metal * 0.85f);

		col += sunColor.xyz * gloss * ndl;
	}

	/* --- mesafe sisi --- */
	{
		float dist = length(worldPos.xyz - eyePosition.xyz);
		float fog = saturate(dist / fogDistance);

		fog = fog * fog;
		col = lerp(col, horizonCol.xyz, fog);
	}

	oColor = float4(saturate(col), 1.0f);
}
