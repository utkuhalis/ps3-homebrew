/* Ucak govdesi - fragment programi.
 *
 * Bilerek solid.fcg kadar sade: isik vertex tarafinda cozuldu, burada
 * yalnizca mesafe sisi kalir. Bu shader ucgen sayisi yuksek bir govdede
 * Gouraud interpolasyonuyla yumusak bir sonuc verir. */
void main
(
	float4 color    : TEXCOORD0,
	float4 worldPos : TEXCOORD1,

	uniform float4 eyePosition,
	uniform float4 horizonCol,
	uniform float  fogDistance,

	out float4 oColor
)
{
	float dist = length(worldPos.xyz - eyePosition.xyz);
	float fog = saturate(dist / fogDistance);

	fog = fog * fog;
	oColor = float4(lerp(saturate(color.rgb), horizonCol.xyz, fog), 1.0f);
}
