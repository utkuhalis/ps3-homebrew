/* Zemin yuzeyleri - fragment programi.
 *
 * Yuzey dokusu DOKUDAN degil, burada hesaplanarak uretilir. Sebebi pratik:
 * RSX'te doku ornekleme calistirilamadi (veri dogru, UV dogru, sampler
 * talimati mikrokodda var, ama tex2D siyah donuyor), ve zaten gokyuzu ile
 * su da ayni sekilde hesapla uretiliyor. Boylece pist de sahnenin geri
 * kalaniyla ayni yolu izliyor.
 *
 * Desen, dusuk fragment hassasiyetine dayanikli olacak sekilde ic ice
 * kucuk katsayili sinuslerden kuruluyor: buyuk carpanlar (frac(sin(x)*43758))
 * RSX'te eziliyor ve duz renge donuyor.
 */

/* Farkli olceklerde bant gurultusu; -1..1 arasi doner */
float noise2(float2 p)
{
	float a = sin(p.x * 1.7f) * sin(p.y * 2.3f);
	float b = sin(p.x * 4.1f + 1.3f) * sin(p.y * 3.7f + 0.7f);
	float c = sin(p.x * 9.3f + 2.1f) * sin(p.y * 8.1f + 1.9f);

	return a * 0.5f + b * 0.32f + c * 0.18f;
}

void main
(
	float4 color    : TEXCOORD0,
	float4 worldPos : TEXCOORD1,
	float2 uv       : TEXCOORD2,
	float4 surfIn   : TEXCOORD3,   /* x: yuzey tipi */

	uniform sampler2D surfaceMap,
	uniform float4 eyePosition,
	uniform float4 horizonCol,
	uniform float  fogDistance,

	out float4 oColor
)
{
	float3 col = color.rgb;
	float kind = surfIn.x;

	/* --- asfalt: ince agrega + boyuna derzler + hafif lekelenme --- */
	if (kind > 0.5f && kind < 1.5f) {
		float grain = noise2(uv * 9.0f) * 0.055f;
		float patch = noise2(uv * 0.7f) * 0.045f;

		/* dokuma derzleri: pist boyunca duzenli araliklarla koyu cizgi */
		float seam = smoothstep(0.46f, 0.5f, abs(frac(uv.y * 0.5f) - 0.5f));

		col *= (1.0f + grain + patch);
		col -= seam * 0.035f;
	}

	/* --- cim: benekli, yer yer kurumus --- */
	if (kind > 1.5f && kind < 2.5f) {
		float blade = noise2(uv * 14.0f) * 0.10f;
		float dry = noise2(uv * 1.1f + 4.0f);

		col *= (1.0f + blade);
		col = lerp(col, float3(0.46f, 0.44f, 0.26f), saturate(dry * 0.35f));
	}

	/* --- beton: genis plakalar, aralarinda derz --- */
	if (kind > 2.5f) {
		float wear = noise2(uv * 2.6f) * 0.05f;
		float jx = smoothstep(0.47f, 0.5f, abs(frac(uv.x * 0.25f) - 0.5f));
		float jy = smoothstep(0.47f, 0.5f, abs(frac(uv.y * 0.25f) - 0.5f));

		col *= (1.0f + wear);
		col -= max(jx, jy) * 0.08f;
	}

	{
		float dist = length(worldPos.xyz - eyePosition.xyz);
		float fog = saturate(dist / fogDistance);

		fog = fog * fog;
		oColor = float4(lerp(saturate(col), horizonCol.xyz, fog), 1.0f);
	}
}
