/* Ucak govdesi - vertex programi.
 *
 * Aydinlatma burada yapilir, fragment tarafinda degil. Once fragment'ta
 * yapiliyordu ve govde simsiyah ciziliyordu: olculdugunde renk varyani
 * fragment programina yalnizca hicbir hesap yokken ulasiyordu
 * (oColor = float4(color.rgb, 1) -> 218), programa herhangi bir carpim
 * eklenir eklenmez sifira dusuyordu (-> 4). Calisan solid.fcg iki varyanla
 * (renk + dunya konumu) hesap yapabiliyor; ucusan shader ucuncu varyani
 * (normal) ekledigi anda bozuluyordu. Bu yuzden normal fragment'a hic
 * gecmez, isik burada cozulur. */
void main
(
	float3 vertexPosition : POSITION,
	float3 vertexNormal   : NORMAL,
	float4 vertexColor    : TEXCOORD0,  /* rgb + metaliklik */

	uniform float4x4 mvpMatrix,
	uniform float4 eyePosition,
	uniform float4 sunDir,
	uniform float4 sunColor,
	uniform float4 horizonCol,
	uniform float4 zenithCol,

	out float4 ePosition : POSITION,
	out float4 oColor    : TEXCOORD0,
	out float4 oWorldPos : TEXCOORD1
)
{
	float3 n = normalize(vertexNormal);
	float3 v = normalize(vertexPosition - eyePosition.xyz);
	float metal = vertexColor.w;

	float ndl = max(dot(n, sunDir.xyz), 0.0f);
	float sky_up = saturate(n.y * 0.5f + 0.5f);
	float3 tint = lerp(horizonCol.xyz, zenithCol.xyz, sky_up);

	/* Ortam isigi gokyuzu tonundan pay alir ama beyaz govde beyaz kalsin
	 * diye baskin olmaz. */
	float3 amb = lerp(float3(0.66f, 0.66f, 0.67f), tint * 0.85f, 0.18f);
	float3 col = vertexColor.xyz * (amb + sunColor.xyz * ndl * 1.05f);

	/* Yansima: cevre olarak ufuk-zenit gecisi alinir, yansiyan yonun
	 * yuksekligine gore. Siyirarak bakilan yerlerde ayna etkisi artar. */
	float3 refl = lerp(horizonCol.xyz, zenithCol.xyz,
	                   saturate((n.y - v.y) * 0.5f + 0.5f));
	float fres = saturate(1.0f + dot(v, n));
	float mirror = metal * (0.10f + 0.24f * fres * fres);

	col = lerp(col, refl * lerp(vertexColor.xyz, float3(1, 1, 1), 0.50f),
	           mirror);

	/* Gunes parlamasi */
	{
		float nh = saturate(dot(n, normalize(sunDir.xyz - v)));
		float g = nh * nh; g = g * g; g = g * g;   /* nh^8 */

		col += sunColor.xyz * g * ndl * (0.25f + metal * 0.55f);
	}

	ePosition = mul(mvpMatrix, float4(vertexPosition, 1.0f));
	oColor    = float4(col, 1.0f);
	oWorldPos = float4(vertexPosition, 1.0f);
}
