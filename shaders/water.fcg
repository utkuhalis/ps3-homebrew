/* Sea surface - fragment program.
 *
 * The sky function must be IDENTICAL to shaders/sky.fcg and
 * source/skycolor.c: the water has to reflect the real sky. */

/* Cloud pattern.
 *
 * RSX's fragment unit runs at low precision; the large constants that
 * hash-based noise needs (e.g. 43758.5453) get crushed and the pattern
 * collapsed to a constant. Nested sines ("domain warping") with small
 * coefficients are used instead, which survive the precision. */
float cloud_pattern(float2 p)
{
	float a = sin(p.x * 0.90f + sin(p.y * 0.70f) * 1.6f);
	float b = sin(p.y * 1.10f + sin(p.x * 0.62f) * 1.4f);
	float c = sin((p.x + p.y) * 0.55f + sin(p.x * 0.31f) * 1.2f);
	float d = sin((p.x - p.y) * 1.70f) * 0.5f;

	return (a + b * 0.85f + c * 0.65f + d) * 0.17f + 0.5f;
}

float3 sky_color(float3 dir, float3 sunDir, float time,
                 float3 horizon, float3 zenith, float3 sunCol, float4 cloudP)
{
	float up = saturate(dir.y);
	float3 col = lerp(horizon, zenith, pow(up, 0.55f));

	float sd = saturate(dot(dir, sunDir));
	col += (pow(sd, 220.0f) * 0.55f + pow(sd, 12.0f) * 0.16f) * sunCol;
	col = lerp(col, sunCol * 1.15f, smoothstep(0.9987f, 0.9994f, sd));

	float yy = max(dir.y, 0.05f);
	float t = 900.0f / yy;
	float2 cp = float2(dir.x * t + 9.0f * time,
	                   dir.z * t + 3.0f * time) * 0.0016f;
	float cover = smoothstep(cloudP.x, cloudP.y, cloud_pattern(cp))
	              * smoothstep(0.02f, 0.30f, dir.y);
	col = lerp(col, float3(1.0f, 0.99f, 0.97f)
	                * (cloudP.z * (0.82f + 0.18f * pow(sd, 4.0f))), cover);
	return saturate(col);
}

void main
(
	float4 worldPos : TEXCOORD0,
	float4 normalIn : TEXCOORD1,

	uniform float4 eyePosition,
	uniform float4 sunDir,
	uniform float4 sunColor,
	uniform float4 horizonCol,
	uniform float4 zenithCol,
	uniform float4 cloudParams,
	uniform float4 waterParams,     /* x: base colour darkening */
	uniform float  timeSec,
	uniform float  fogDistance,

	out float4 oColor
)
{
	/* The slope of small waves is added on top of the geometric normal, so the
	 * surface looks finely detailed even though the grid is sparse.
	 *
	 * Two things matter:
	 * - Directions and wavelengths are chosen incommensurate, otherwise the
	 *   pattern repeats and the surface looks "layered".
	 * - Detail fades with distance: far away the fine waves are smaller than a
	 *   pixel and, unless faded, turn into shimmering bands. */
	float3 n = normalize(normalIn.xyz);
	{
		float d0 = length(worldPos.xyz - eyePosition.xyz);
		float detail = saturate(1.0f - d0 / 520.0f);

		/* Wavelengths are incommensurate (close to primes); nearby frequencies
		 * interfered and produced a repeating honeycomb pattern. */
		float3 dx = float3(-0.37f,  0.94f, -0.71f);
		float3 dz = float3( 0.93f, -0.34f,  0.70f);
		float3 kk = 6.28318531f / float3(37.0f, 19.0f, 11.0f);
		float3 aa = float3(0.24f, 0.12f, 0.05f) * detail;
		float3 sp = float3(1.55f, 2.05f, 2.70f);

		/* a different phase offset per component breaks up regular repetition */
		float3 warp = float3(sin(worldPos.z * 0.023f + timeSec * 0.61f) * 1.6f,
		                     sin(worldPos.x * 0.017f - timeSec * 0.83f) * 1.9f,
		                     sin((worldPos.x + worldPos.z) * 0.011f
		                         + timeSec * 0.47f) * 2.3f);

		float3 ph = (worldPos.x * dx + worldPos.z * dz) * kk
		            + timeSec * sp * kk * 12.0f + warp;
		float3 cc = cos(ph) * aa * kk;

		n = normalize(n + float3(-dot(cc, dx), 0.0f, -dot(cc, dz)));
	}
	float3 v = normalize(worldPos.xyz - eyePosition.xyz);

	/* sky reflection */
	float3 r = reflect(v, n);
	r.y = abs(r.y);
	float3 sky = sky_color(r, sunDir.xyz, timeSec, horizonCol.xyz,
	                       zenithCol.xyz, sunColor.xyz, cloudParams);

	/* Fresnel: deep water colour when looking straight down, reflection at
 * grazing angles */
	float fres = 0.02f + 0.98f * pow(1.0f - saturate(-dot(v, n)), 5.0f);
	float3 col = lerp(float3(0.015f, 0.075f, 0.135f) * waterParams.x,
	                  sky, saturate(fres));

	/* sun glitter: a light path shimmering on the waves */
	float3 h = normalize(sunDir.xyz - v);
	float sd = saturate(dot(h, n));
	col += (pow(sd, 180.0f) * 1.6f + pow(sd, 24.0f) * 0.10f) * sunColor.xyz;

	/* blend to the horizon colour with distance */
	float dist = length(worldPos.xyz - eyePosition.xyz);
	float fog = saturate(dist / fogDistance);
	fog = fog * fog;
	col = lerp(col, sky_color(normalize(float3(v.x, 0.02f, v.z)), sunDir.xyz,
	                          timeSec, horizonCol.xyz, zenithCol.xyz,
	                          sunColor.xyz, cloudParams), fog);

	oColor = float4(saturate(col), 1.0f);
}
