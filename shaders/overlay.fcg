/* 2D overlay - fragment program.
 *
 * params.x  shape: 0 rectangle, 1 soft blob, 2 ring/disc
 * params.yz corner UV (0..1)
 * params.w  inner ring radius (0 means a filled disc)
 *
 * Blending is used instead of branching; branches are expensive on the
 * fragment unit and unreliable in some cases. */
void main
(
	float4 color  : TEXCOORD0,
	float4 params : TEXCOORD1,

	out float4 oColor
)
{
	float2 uv = params.yz;
	float  d  = length(uv - 0.5f) * 2.0f;

	float blob = 1.0f - smoothstep(0.15f, 1.0f, d);
	float ring = smoothstep(params.w - 0.10f, params.w + 0.02f, d)
	             * (1.0f - smoothstep(0.90f, 1.0f, d));

	float m1 = saturate(params.x);
	float m2 = saturate(params.x - 1.0f);

	float a = color.a * lerp(lerp(1.0f, blob, m1), ring, m2);

	oColor = float4(color.rgb, a);
}
