/* 2D overlay - vertex program.
 *
 * Positions arrive in clip space. Colour travels in the NORMAL attribute,
 * opacity and shape in TEXCOORD0:
 *   x = opacity, y = shape (0 rectangle, 1 soft disc), zw = corner UV */
void main
(
	float3 vertexPosition : POSITION,
	float3 vertexNormal   : NORMAL,
	float4 vertexTexcoord : TEXCOORD0,
	float  vertexInner    : TEXCOORD1,

	out float4 ePosition : POSITION,
	out float4 oColor    : TEXCOORD0,
	out float4 oParams   : TEXCOORD1
)
{
	ePosition = float4(vertexPosition.xy, 0.0f, 1.0f);
	oColor    = float4(vertexNormal, vertexTexcoord.x);
	oParams   = float4(vertexTexcoord.y, vertexTexcoord.z, vertexTexcoord.w,
	                   vertexInner);
}
