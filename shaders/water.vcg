/* Deniz yuzeyi - vertex programi.
 *
 * Dalga formulunun C karsiligi source/waves.c icindedir, BIREBIR ayni
 * tutulmalidir. Yukseklik ve yuzey normali burada hesaplanip fragment'a
 * tasinir; normal dogru olmazsa parlama ve yansima yanlis gorunur. */
void main
(
	float3 vertexPosition : POSITION,
	float3 vertexNormal   : NORMAL,
	float2 vertexTexcoord : TEXCOORD0,

	uniform float4x4 mvpMatrix,
	uniform float    timeSec,
	uniform float2   worldOffset,
	uniform float    waveScale,
	uniform float    waveLength,

	out float4 ePosition : POSITION,
	out float4 oWorldPos : TEXCOORD0,
	out float4 oNormal   : TEXCOORD1
)
{
	float3 p = vertexPosition + vertexNormal * 0.0f
	           + float3(vertexTexcoord, 0.0f) * 0.0f;

	/* Geometride uc buyuk dalga tasinir; kucuk dalgalar izgara
	 * cozunurlugune sigmadigi icin fragment tarafinda normal olarak eklenir.
	 * Yonler bilerek birbirine paralel degil ve dalga boylari birbirinin
	 * tam kati degil; aksi halde desen tekrar edip "kat kat" gorunuyor. */
	float4 dirX  = float4( 0.98f, -0.42f,  0.55f, 0.0f);
	float4 dirZ  = float4( 0.17f,  0.91f, -0.83f, 0.0f);
	float4 len   = float4(163.0f, 89.0f,  47.0f,  1.0f) * waveLength;
	float4 amp   = float4(  1.05f, 0.58f,  0.27f, 0.0f) * waveScale;
	float4 speed = float4(  0.85f, 1.21f,  1.63f, 0.0f);

	float4 k = 6.28318531f / len;
	/* Dalga fazi DUNYA koordinatindan hesaplanir. Duzlem kamerayla birlikte
	 * kaydigi icin yerel koordinat kullanilirsa desen de kamerayla birlikte
	 * suruklenir ve deniz sabit durmaz. */
	float2 wp = float2(p.x + worldOffset.x, p.z + worldOffset.y);

	/* Dalganin icine dalga: fazi konuma bagli olarak kaydirmak duzenli
	 * sinus desenini kirar ve deniz dogal gorunur. */
	float warp = sin(wp.x * 0.0071f + timeSec * 0.31f) * 1.7f
	           + sin(wp.y * 0.0053f - timeSec * 0.23f) * 1.4f;

	float4 phase = (wp.x * dirX + wp.y * dirZ) * k
	             + timeSec * speed * k * 12.0f + warp;

	float4 s = sin(phase);
	float4 c = cos(phase) * amp * k;

	float h = dot(s, amp);
	float dhdx = dot(c, dirX);
	float dhdz = dot(c, dirZ);

	p.y += h;

	ePosition = mul(mvpMatrix, float4(p, 1.0f));
	oWorldPos = float4(p.x + worldOffset.x, p.y, p.z + worldOffset.y, 1.0f);
	oNormal   = float4(normalize(float3(-dhdx, 1.0f, -dhdz)), 0.0f);
}
