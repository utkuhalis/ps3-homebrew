/* Ground surfaces - vertex program.
 * Colour travels in a vertex attribute; TEXCOORD0 carries brightness and
 * surface type, and the texture coordinate carries a UV that repeats at
 * world scale. */
void main
(
	float3 vertexPosition : POSITION,
	float3 vertexNormal   : NORMAL,     /* colour */
	float4 vertexTexcoord : TEXCOORD0,  /* x: brightness, y: surface type, zw: uv */

	uniform float4x4 mvpMatrix,

	out float4 ePosition : POSITION,
	out float4 oColor    : TEXCOORD0,
	out float4 oWorldPos : TEXCOORD1,
	out float2 oUV       : TEXCOORD2,
	out float4 oSurf     : TEXCOORD3
)
{
	ePosition = mul(mvpMatrix, float4(vertexPosition, 1.0f));
	oColor    = float4(vertexNormal * vertexTexcoord.x, 1.0f);
	oWorldPos = float4(vertexPosition, 1.0f);
	oUV       = vertexTexcoord.zw;
	oSurf     = float4(vertexTexcoord.y, 0.0f, 0.0f, 0.0f);
}
