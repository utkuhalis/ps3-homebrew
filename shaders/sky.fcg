/* Sky - fragment program.
 *
 * The C version of these formulas is in source/skycolor.c and must stay
 * IDENTICAL: the water reflects the same sky, so if the two drift apart
 * the sea reflects something other than the sky above it. */

/* Cloud pattern.
 *
 * RSX's fragment unit runs at low precision; the large constants that
 * hash-based noise needs (e.g. 43758.5453) get crushed and the pattern
 * collapsed to a constant. Nested sines ("domain warping") with small
 * coefficients are used instead, which survive the precision. */
float cloud_pattern(float2 p)
{
	float a = sin(p.x * 0.90f + sin(p.y * 0.70f) * 1.6f);
	float b = sin(p.y * 1.10f + sin(p.x * 0.62f) * 1.4f);
	float c = sin((p.x + p.y) * 0.55f + sin(p.x * 0.31f) * 1.2f);
	float d = sin((p.x - p.y) * 1.70f) * 0.5f;

	return (a + b * 0.85f + c * 0.65f + d) * 0.17f + 0.5f;
}

float3 sky_color(float3 dir, float3 sunDir, float time,
                 float3 horizon, float3 zenith, float3 sunCol,
                 float4 cloudP)
{
	float up = saturate(dir.y);
	float grad = pow(up, 0.55f);
	float3 col = lerp(horizon, zenith, grad);

	/* sun: sharp disc + wide halo */
	float sd = saturate(dot(dir, sunDir));
	float disk = smoothstep(0.9987f, 0.9994f, sd);
	float glow = pow(sd, 220.0f) * 0.55f + pow(sd, 12.0f) * 0.16f;

	col += glow * sunCol;
	col = lerp(col, sunCol * 1.15f, disk);

	/* clouds: layered noise where the ray meets the cloud layer */
	/* Clouds: the pattern is taken where the view ray crosses the cloud layer.
	 * A multiplier is used instead of a branch (safer on the fragment unit). */
	float yy = max(dir.y, 0.05f);
	float t = 900.0f / yy;
	float2 cp = float2(dir.x * t + 9.0f * time,
	                   dir.z * t + 3.0f * time) * 0.0016f;

	/* cloudP: x = lower threshold, y = upper threshold, z = brightness */
	float cover = smoothstep(cloudP.x, cloudP.y, cloud_pattern(cp));
	cover *= smoothstep(0.02f, 0.30f, dir.y);

	float lit = cloudP.z * (0.82f + 0.18f * pow(sd, 4.0f));
	col = lerp(col, float3(1.00f, 0.99f, 0.97f) * lit, cover);

	return saturate(col);
}

void main
(
	float4 rayDir : TEXCOORD0,

	uniform float4 sunDir,
	uniform float4 sunColor,
	uniform float4 horizonCol,
	uniform float4 zenithCol,
	uniform float4 cloudParams,
	uniform float  timeSec,

	out float4 oColor
)
{
	float3 d = normalize(rayDir.xyz);

	oColor = float4(sky_color(d, sunDir.xyz, timeSec,
	                          horizonCol.xyz, zenithCol.xyz, sunColor.xyz,
	                          cloudParams), 1.0f);
}
