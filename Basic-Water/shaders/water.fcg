/* Deniz yuzeyi - fragment programi.
 *
 * Gokyuzu fonksiyonu shaders/sky.fcg ve source/skycolor.c ile BIREBIR ayni
 * olmalidir: su, gercek gokyuzunu yansitmali. */

/* Bulut deseni.
 *
 * RSX'in fragment birimi dusuk hassasiyetle calisir; hash tabanli gurultunun
 * gerektirdigi buyuk sabitler (orn. 43758.5453) burada eziliyor ve desen
 * sabite donuyordu. Bunun yerine ic ice sinuslerle ("domain warping")
 * kucuk katsayili, hassasiyete dayanikli bir desen kullaniliyor. */
float cloud_pattern(float2 p)
{
	float a = sin(p.x * 0.90f + sin(p.y * 0.70f) * 1.6f);
	float b = sin(p.y * 1.10f + sin(p.x * 0.62f) * 1.4f);
	float c = sin((p.x + p.y) * 0.55f + sin(p.x * 0.31f) * 1.2f);
	float d = sin((p.x - p.y) * 1.70f) * 0.5f;

	return (a + b * 0.85f + c * 0.65f + d) * 0.17f + 0.5f;
}

float3 sky_color(float3 dir, float3 sunDir, float time)
{
	float up = saturate(dir.y);
	float3 col = lerp(float3(0.72f, 0.82f, 0.92f),
	                  float3(0.16f, 0.38f, 0.78f), pow(up, 0.55f));

	float sd = saturate(dot(dir, sunDir));
	col += (pow(sd, 220.0f) * 0.55f + pow(sd, 12.0f) * 0.16f)
	       * float3(1.00f, 0.92f, 0.72f);
	col = lerp(col, float3(1.00f, 0.98f, 0.90f),
	           smoothstep(0.9987f, 0.9994f, sd));

	float yy = max(dir.y, 0.05f);
	float t = 900.0f / yy;
	float2 cp = float2(dir.x * t + 9.0f * time,
	                   dir.z * t + 3.0f * time) * 0.0016f;
	float cover = smoothstep(0.50f, 0.78f, cloud_pattern(cp))
	              * smoothstep(0.02f, 0.30f, dir.y);
	col = lerp(col, float3(1.0f, 0.99f, 0.97f)
	                * (0.82f + 0.18f * pow(sd, 4.0f)), cover);
	return saturate(col);
}

void main
(
	float4 worldPos : TEXCOORD0,
	float4 normalIn : TEXCOORD1,

	uniform float4 eyePosition,
	uniform float4 sunDir,
	uniform float  timeSec,
	uniform float  fogDistance,

	out float4 oColor
)
{
	/* Geometrik normalin uzerine kucuk dalgalarin egimi eklenir; boylece
	 * izgara seyrek olsa da yuzey ince detayli gorunur. */
	float3 n = normalize(normalIn.xyz);
	{
		float2 dx = float2(-0.45f, 0.86f);
		float2 dz = float2( 0.89f, -0.51f);
		float2 k  = 6.28318531f / float2(38.0f, 19.0f);
		float2 a  = float2(0.30f, 0.14f);
		float2 sp = float2(1.70f, 2.20f);

		float2 ph = (worldPos.x * dx + worldPos.z * dz) * k
		            + timeSec * sp * k * 12.0f;
		float2 c  = cos(ph) * a * k;

		n = normalize(n + float3(-dot(c, dx), 0.0f, -dot(c, dz)));
	}
	float3 v = normalize(worldPos.xyz - eyePosition.xyz);

	/* gokyuzu yansimasi */
	float3 r = reflect(v, n);
	r.y = abs(r.y);
	float3 sky = sky_color(r, sunDir.xyz, timeSec);

	/* Fresnel: dik bakista derin su rengi, sig acida yansima baskin */
	float fres = 0.02f + 0.98f * pow(1.0f - saturate(-dot(v, n)), 5.0f);
	float3 col = lerp(float3(0.015f, 0.075f, 0.135f), sky, saturate(fres));

	/* gunes parlamasi: dalgalar uzerinde kipirdayan isik yolu */
	float3 h = normalize(sunDir.xyz - v);
	float sd = saturate(dot(h, n));
	col += (pow(sd, 180.0f) * 1.6f + pow(sd, 24.0f) * 0.10f)
	       * float3(1.00f, 0.95f, 0.80f);

	/* mesafeyle ufuk rengine karisma */
	float dist = length(worldPos.xyz - eyePosition.xyz);
	float fog = saturate(dist / fogDistance);
	fog = fog * fog;
	col = lerp(col, sky_color(normalize(float3(v.x, 0.02f, v.z)), sunDir.xyz, timeSec), fog);

	oColor = float4(saturate(col), 1.0f);
}
