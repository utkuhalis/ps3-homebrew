/* Gokyuzu - fragment programi.
 *
 * Formullerin C karsiligi source/skycolor.c icindedir ve BIREBIR ayni
 * tutulmalidir; su yansimasi da ayni gokyuzunu kullandigi icin ikisi
 * ayrisirsa deniz gercek gokyuzunden farkli bir sey yansitir. */

/* Bulut deseni.
 *
 * RSX'in fragment birimi dusuk hassasiyetle calisir; hash tabanli gurultunun
 * gerektirdigi buyuk sabitler (orn. 43758.5453) burada eziliyor ve desen
 * sabite donuyordu. Bunun yerine ic ice sinuslerle ("domain warping")
 * kucuk katsayili, hassasiyete dayanikli bir desen kullaniliyor. */
float cloud_pattern(float2 p)
{
	float a = sin(p.x * 0.90f + sin(p.y * 0.70f) * 1.6f);
	float b = sin(p.y * 1.10f + sin(p.x * 0.62f) * 1.4f);
	float c = sin((p.x + p.y) * 0.55f + sin(p.x * 0.31f) * 1.2f);
	float d = sin((p.x - p.y) * 1.70f) * 0.5f;

	return (a + b * 0.85f + c * 0.65f + d) * 0.17f + 0.5f;
}

float3 sky_color(float3 dir, float3 sunDir, float time)
{
	float up = saturate(dir.y);
	float grad = pow(up, 0.55f);

	float3 horizon = float3(0.72f, 0.82f, 0.92f);
	float3 zenith  = float3(0.16f, 0.38f, 0.78f);
	float3 col = lerp(horizon, zenith, grad);

	/* gunes: keskin disk + genis hale */
	float sd = saturate(dot(dir, sunDir));
	float disk = smoothstep(0.9987f, 0.9994f, sd);
	float glow = pow(sd, 220.0f) * 0.55f + pow(sd, 12.0f) * 0.16f;

	col += glow * float3(1.00f, 0.92f, 0.72f);
	col = lerp(col, float3(1.00f, 0.98f, 0.90f), disk);

	/* bulutlar: isinin bulut katmanini kestigi noktada katmanli gurultu */
	/* Bulutlar: bakis isini bulut katmanini nerede kesiyorsa orada desen.
	 * Dallanma yerine carpan kullanilir (fragment biriminde daha guvenli). */
	float yy = max(dir.y, 0.05f);
	float t = 900.0f / yy;
	float2 cp = float2(dir.x * t + 9.0f * time,
	                   dir.z * t + 3.0f * time) * 0.0016f;

	float cover = smoothstep(0.50f, 0.78f, cloud_pattern(cp));
	cover *= smoothstep(0.02f, 0.30f, dir.y);

	float lit = 0.82f + 0.18f * pow(sd, 4.0f);
	col = lerp(col, float3(1.00f, 0.99f, 0.97f) * lit, cover);

	return saturate(col);
}

void main
(
	float4 rayDir : TEXCOORD0,

	uniform float4 sunDir,
	uniform float  timeSec,

	out float4 oColor
)
{
	float3 d = normalize(rayDir.xyz);

	oColor = float4(sky_color(d, sunDir.xyz, timeSec), 1.0f);
}
